# ==========================================
# Project Specific & Local Storage
# ==========================================
downloads/
.syncthing/

# Syncthing runtime state — config, certs and the index DB all change on
# every sync and must never be tracked:
#   git rm -r --cached syncthing_config
syncthing_config/

# Built frontend is embedded in the Go binary; only the placeholder is tracked
!backend/web/dist/
backend/web/dist/*
!backend/web/dist/index.html

# Local Go build artifacts
backend/soneph-server
backend/soneph-server.exe

# Tooling internal state
.freebuff/
